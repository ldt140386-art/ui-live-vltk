#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_APP_ICON            ICON                    "app.ico"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_MAIN_DIALOG DIALOGEX 0, 0, 840, 480
STYLE DS_SETFONT | DS_CENTER | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "FindInProcess - Process File & Resource Monitor"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "Process:",IDC_LABEL_PROCESS,8,10,32,8
    COMBOBOX        IDC_COMBO_PROCESS,44,7,260,160,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Refresh",IDC_BTN_REFRESH_PROCESS,310,7,52,14
    PUSHBUTTON      "Start",IDC_BTN_START,368,7,48,14
    PUSHBUTTON      "Stop",IDC_BTN_STOP,420,7,48,14
    PUSHBUTTON      "Snapshot",IDC_BTN_SNAPSHOT,472,7,58,14
    PUSHBUTTON      "Clear",IDC_BTN_CLEAR,534,7,48,14
    CONTROL         "Auto Scroll",IDC_CHECK_AUTOSCROLL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,586,9,52,10
    
    LTEXT           "Click:",IDC_STATIC_CLICK_LABEL,590,10,22,8
    EDITTEXT        IDC_EDIT_CLICK_POINT,616,7,216,14,ES_AUTOHSCROLL | ES_READONLY

    LTEXT           "Window:",IDC_STATIC_WINDOW_LABEL,8,27,32,8
    EDITTEXT        IDC_EDIT_CLICK_WINDOW,44,24,260,14,ES_AUTOHSCROLL | ES_READONLY
    
    LTEXT           "Resource:",IDC_STATIC_RESOURCE_LABEL,310,27,36,8
    EDITTEXT        IDC_EDIT_CLICK_RESOURCE,350,24,482,14,ES_AUTOHSCROLL | ES_READONLY

    LTEXT           "Filter / Search:",IDC_STATIC_SEARCH_LABEL,8,44,52,8
    EDITTEXT        IDC_EDIT_SEARCH_FILTER,62,41,346,14,ES_AUTOHSCROLL
    PUSHBUTTON      "X",IDC_BTN_CLEAR_SEARCH,410,41,18,14
    PUSHBUTTON      "Batch Unpack...",IDC_BTN_UNPACK_BATCH,430,41,60,14

    CONTROL         "",IDC_LIST_FILES,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,8,58,482,390

    GROUPBOX        "Preview",IDC_GROUP_PREVIEW,494,44,338,404
    CONTROL         "Animation",IDC_CHECK_ANIMATION,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,540,43,54,10
    PUSHBUTTON      "|<<",IDC_BTN_FRAME_PREV,600,42,24,12
    PUSHBUTTON      ">>|",IDC_BTN_FRAME_NEXT,626,42,24,12
    LTEXT           "Zoom:",IDC_STATIC_ZOOM_LABEL,660,44,22,8
    COMBOBOX        IDC_COMBO_ZOOM,684,41,40,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Sheet",IDC_BTN_SHEET_VIEW,726,41,36,12
    
    EDITTEXT        IDC_EDIT_PREVIEW_TEXT,502,58,322,170,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL
    CONTROL         "",IDC_STATIC_PREVIEW_IMAGE,"Static",SS_BITMAP | SS_NOTIFY | SS_CENTERIMAGE | WS_BORDER,502,58,322,170
    CONTROL         "",IDC_STATIC_UI_COMPOSITE,"Static",SS_BITMAP | SS_NOTIFY | SS_CENTERIMAGE | WS_BORDER,502,234,322,176
    
    LTEXT           "Select a row to preview.",IDC_STATIC_PREVIEW_INFO,502,416,210,24
    PUSHBUTTON      "Play",IDC_BTN_PREVIEW_PLAY,716,420,50,14
    PUSHBUTTON      "Stop",IDC_BTN_PREVIEW_STOP,772,420,50,14

    PUSHBUTTON      "Open Folder",IDC_BTN_OPEN_FOLDER,8,454,64,14
    PUSHBUTTON      "Open PAK File...",IDC_BTN_OPEN_PAK,74,454,72,14
    PUSHBUTTON      "Export Paths",IDC_BTN_EXPORT_PATHS,148,454,88,14
    LTEXT           "Ready. Select a process, then Snapshot or Start.",IDC_STATIC_STATUS,240,457,592,12
END

IDR_CONTEXT_MENU MENU
BEGIN
    POPUP "Popup"
    BEGIN
        MENUITEM "Copy Path",                           ID_MENU_COPY_PATH
        MENUITEM "Copy UID",                            ID_MENU_COPY_UID
        MENUITEM SEPARATOR
        MENUITEM "Unpak Resource (Trích xuất file này)...", ID_MENU_UNPACK
        MENUITEM "Unpak Các File Đã Chọn (Batch)...",     ID_MENU_UNPACK_SELECTED
        MENUITEM "Unpak Toàn Bộ Danh Sách Đang Lọc...",   ID_MENU_UNPACK_ALL_FILTERED
        MENUITEM SEPARATOR
        MENUITEM "Open Containing Folder",              ID_MENU_OPEN_CONTAINING_FOLDER
    END
END

